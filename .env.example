# Every setting, with its default (spec/decisions/0008). To change one, copy this file to .env,
# which stays out of git. The backends' services pass these on.

# Where Compose publishes each backend, on 127.0.0.1.
PYTHON_FASTAPI_PORT=8001
GO_NETHTTP_PORT=8002
GO_GIN_PORT=8003

# Where Compose publishes the fake upstream server, on 127.0.0.1.
FAKE_SERVER_PORT=8010

# Each backend's limits, the same for every backend: CPUs, and memory as Docker writes it, such as
# 512m. Provisional until plan step 3.1 (spec/decisions/0020).
BACKEND_CPUS=1
BACKEND_MEMORY=512m

# The upstream: `fake` for the fake inside each backend, or `openai-compatible` to call the one
# the settings below name (contract/README.md#the-upstream).
LLM_PROVIDER=fake

# The upstream a backend calls with `openai-compatible`: the fake server by default. A key stays
# in .env, never in git. The timeout is in seconds, for each wait in which nothing arrives.
LLM_BASE_URL=http://fake-server:8080/v1
LLM_MODEL=local
LLM_API_KEY=local
LLM_TIMEOUT_SECONDS=300
LLM_MAX_CONNECTIONS=1000

# The fakes (contract/README.md#the-fakes). Whole numbers; the defaults answer as fast as they can.
FAKE_ANSWER_TOKENS=256
FAKE_REASONING_TOKENS=0
FAKE_FIRST_TOKEN_MS=0
FAKE_TOKEN_GAP_MS=0

# The machine the runner's runs are made on, in your own words, such as
# "Apple M3, 8 cores, 8 GB, macOS 14.3, Colima". Docker in a VM can't see its host, so each run
# records this beside what Docker reports (spec/decisions/0018).
BENCH_MACHINE=
